# Point the management app at the Redface Pay project (the same database as Face and Staff).
# Publishable key (sb_publishable_…) or the legacy anon key. Do not put a secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 32-byte key, base64. The station needs the same value.
BIOMETRIC_KEY=

# Signs the management session cookie. Required in production.
SESSION_SECRET=

